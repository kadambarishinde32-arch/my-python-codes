for i in range(1, 4):
    num = 2 * i - 1
    print(" " * (3 - i), end="")
    for j in range(num):
        print(num, end=" ")
    print()

for i in range(2, 0, -1):
    num = 2 * i - 1
    print(" " * (3 - i), end="")
    for j in range(num):
        print(num, end=" ")
    print()

